    {"note": "hollow body", "osc": "sine", "freq": 190, "gain": 0.25, "pitchEnv": {"to": 0.8, "time": 0.1}, "env": {"a": 0.002, "d": 0.14}},
    {"note": "tick", "noise": "white", "gain": 0.08, "filter": {"type": "bandpass", "freq": 2600, "q": 1.5}, "env": {"a": 0.001, "d": 0.025}}
  ]
}
