  "bus": "sfx",
  "volume": 0.7,
  "spatial": true,
  "refDistance": 1.5,
  "maxDistance": 25,
  "reverb": 0.25,
  "vary": {"pitch": 2, "filter": 0.3, "gain": 2},
  "layers": [
