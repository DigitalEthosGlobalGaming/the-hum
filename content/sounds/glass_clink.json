    {"note": "glass body", "osc": "sine", "freq": 2050, "gain": 0.09, "env": {"a": 0.001, "d": 0.22}},
    {"note": "glass overtone", "osc": "sine", "freq": 4430, "gain": 0.04, "env": {"a": 0.001, "d": 0.12}}
  ]
}
