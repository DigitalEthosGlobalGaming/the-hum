    {"note": "heel knock", "noise": "brown", "gain": 0.5, "filter": {"type": "lowpass", "freq": 520, "q": 0.8}, "env": {"a": 0.002, "d": 0.09}},
    {"note": "scrape", "noise": "pink", "gain": 0.1, "start": 0.04, "filter": {"type": "highpass", "freq": 1800, "q": 0.7}, "env": {"a": 0.01, "d": 0.07}, "vary": {"time": 0.02, "gain": 3}}
  ]
}
