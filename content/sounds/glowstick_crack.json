{
  "id": "glowstick_crack",
  "note": "Glow stick bent until the inner vial snaps: crunch, glassy tick, a shake.",
  "bus": "sfx",
  "volume": 0.8,
  "spatial": true,
  "refDistance": 1,
  "maxDistance": 10,
  "reverb": 0.1,
  "vary": {
    "pitch": 1,
    "gain": 1.5
  },
  "layers": [
    {
      "note": "plastic crunch",
      "noise": "white",
      "gain": 1.17,
      "filter": {
        "type": "bandpass",
        "freq": 2200,
        "q": 1.2
      },
      "env": {
        "a": 0.001,
        "d": 0.05
      },
      "repeat": {
        "count": 3,
        "interval": 0.025,
        "jitter": 0.008
      }
    },
    {
      "note": "vial snap",
      "noise": "white",
      "gain": 0.78,
      "start": 0.06,
      "filter": {
        "type": "highpass",
        "freq": 6000
      },
      "env": {
        "a": 0.0005,
        "d": 0.01
      }
    },
    {
      "note": "shake",
      "noise": "pink",
      "gain": 0.312,
      "start": 0.25,
      "filter": {
        "type": "bandpass",
        "freq": 1500,
        "q": 1
      },
      "env": {
        "a": 0.01,
        "d": 0.06
      },
      "repeat": {
        "count": 3,
        "interval": 0.12,
        "jitter": 0.02
      }
    }
  ]
}
