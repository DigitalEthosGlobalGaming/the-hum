{
  "id": "match_burn",
  "note": "A lit match held close (loop, stopped by match_strike): soft flame flutter and tiny wood crackle.",
  "bus": "sfx",
  "volume": 0.5,
  "loop": true,
  "vary": {"pitch": 0.3, "filter": 0.1},
  "layers": [
    {"note": "flutter", "noise": "brown", "gain": 0.5, "filter": {"type": "lowpass", "freq": 380, "q": 0.7}, "env": {"a": 0.25, "d": 0, "s": 1, "r": 0.6}, "lfo": [{"target": "gain", "wave": "noise", "rate": 7, "depth": 0.6}, {"target": "filter", "wave": "noise", "rate": 3, "depth": 160}]},
    {"note": "crackle", "noise": "white", "gain": 0.07, "filter": {"type": "bandpass", "freq": 2600, "q": 2}, "env": {"a": 0.3, "d": 0, "s": 1, "r": 0.4}, "lfo": {"target": "gain", "wave": "noise", "rate": 18, "depth": 0.95}}
  ]
}
