  "layers": [
    {
      "note": "snap",
      "noise": "white",
      "gain": 0.9,
      "filter": {
        "type": "bandpass",
        "freq": 3200,
        "q": 2
      },
      "env": {
        "a": 0.0005,
        "d": 0.012
      }
    },
    {
      "note": "body knock",
      "osc": "sine",
      "freq": 420,
      "gain": 0.63,
      "pitchEnv": {
        "to": 0.6,
        "time": 0.03
      },
      "env": {
        "a": 0.001,
        "d": 0.04
      }
    },
    {
      "note": "spring rebound",
      "noise": "white",
      "gain": 0.27,
      "start": 0.018,
      "filter": {
        "type": "highpass",
        "freq": 5000
      },
      "env": {
        "a": 0.0005,
        "d": 0.008
      }
    }
  ]
