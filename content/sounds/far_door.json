    {"note": "slam", "noise": "brown", "gain": 0.8, "start": 0.75, "filter": {"type": "lowpass", "freq": 260, "q": 1}, "env": {"a": 0.002, "d": 0.5}},
    {"note": "slam sub", "osc": "sine", "freq": 70, "gain": 0.5, "start": 0.75, "pitchEnv": {"to": 0.6, "time": 0.25}, "env": {"a": 0.002, "d": 0.45}},
    {"note": "latch", "noise": "white", "gain": 0.12, "start": 0.76, "filter": {"type": "bandpass", "freq": 2200, "q": 3}, "env": {"a": 0.0005, "d": 0.03}}
  ]
