    {"note": "squeak", "osc": "saw", "freq": 940, "gain": 0.06, "filter": {"type": "bandpass", "freq": 2300, "q": 6}, "pitchEnv": {"to": 1.12, "time": 0.12, "curve": "lin"}, "env": {"a": 0.02, "d": 0.14}, "lfo": {"target": "pitch", "wave": "noise", "rate": 25, "depth": 120}, "repeat": {"count": 64, "interval": 0.9, "jitter": 0.4}, "vary": {"pitch": 2, "gain": 5}}
