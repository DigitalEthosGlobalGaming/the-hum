{
  "id": "lights_out",
  "title": "Lights out",
  "hint": "Switch it all off. Stand in it. Wait.",
  "order": 2,
  "once": true,
  "trigger": {
    "event": "tick",
    "where": {
      "$recent": { "event": "power:switch", "where": { "on": false }, "within": 180, "sameRoom": true },
      "$torch": false,
      "$light": { "max": 0.08 },
      "$hold": 10
    }
  },
  "script": "secret_lights_out",
  "params": {
    "writing": "dark_writing",
    "lines": [
      "{steps} STEPS. NONE HOME",
      "I COUNTED {steps} STEPS",
      "{steps} STEPS. KEEP GOING"
    ],
    "read": [
      "{steps} steps, it says. That's exactly how many you've taken. Nobody else was counting.",
      "The writing knows your step count: {steps}. It is still wet."
    ]
  }
}
